# Copy to .env and `source .env` (or export these in your shell) before running any script.

# --- required ---
# Working bucket (you create it; see README "Setup"). Prefixes used: input/ transcripts/ plans/ output/ test/
export ZVE_BUCKET=my-meetup-video-bucket

# --- optional ---
# AWS region of the bucket, Transcribe and MediaConvert (Bedrock uses a global inference profile).
export ZVE_REGION=ap-northeast-2
# If set, preflight.sh fails when the active credentials belong to a different account.
export ZVE_ACCOUNT=
# Cost-allocation tag value put on every resource (bucket objects, Transcribe/MediaConvert jobs, IAM role).
export ZVE_PROJECT_TAG=zoom-video-edit
# Event name used by make_meta.py in generated titles/descriptions.
export ZVE_EVENT="My Monthly Meetup"
# Python interpreter with boto3 + google libs installed (default: ~/.cache/zoom-video-edit/venv/bin/python).
export ZVE_PYTHON=$HOME/.cache/zoom-video-edit/venv/bin/python
# Zoom ingest only: Netscape cookies file for recordings behind SSO, and the recording passcode.
export ZVE_COOKIES=
export ZVE_ZOOM_PASSCODE=
